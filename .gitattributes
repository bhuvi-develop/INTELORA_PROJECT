# Normalise to LF in the repository and let Git restore native endings on
# checkout, with two exceptions that matter.
* text=auto eol=lf

# Batch files must arrive with CRLF whatever the cloner's core.autocrlf is set
# to. cmd.exe mis-parses a LF-only script - labels stop resolving and the
# launcher fails in ways that look like a broken project rather than a broken
# line ending.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets Git should never try to diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
