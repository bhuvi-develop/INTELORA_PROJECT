# INTELORA backend configuration.
# Copy to .env and adjust. Every value below is the built-in default, so an
# empty .env is a valid .env — only set what differs on this machine.

# ── Application ─────────────────────────────────────────────────────────
APP_NAME=INTELORA Backend
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO

# ── PostgreSQL ──────────────────────────────────────────────────────────
# The database is created automatically on first start if it does not exist.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intelora_db

# Set DATABASE_URL to override the four values above with a full URL.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intelora_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── MIKOS sensor engine ─────────────────────────────────────────────────
# The sensor publishes once per second.
TICK_INTERVAL_SECONDS=1.0

# Persist every Nth tick. 1 stores every generated reading. Raise it to trade
# resolution for write volume on a constrained machine.
PERSIST_EVERY_N_TICKS=1

# Rolling in-memory window per device, read by the live APIs and both models.
LIVE_WINDOW_SAMPLES=900

# Degradation clock for the live stream only. At 60, one second of watching
# advances service life by one minute. The historical back-fill always runs at
# true rate — one day of wear per day of history.
WEAR_TIME_SCALE=60

# ── Retention ───────────────────────────────────────────────────────────
# Per-second rows older than this are pruned. Down-sampled history is kept.
RAW_RETENTION_HOURS=24
RETENTION_INTERVAL_SECONDS=900
ANALYTICS_INTERVAL_SECONDS=30

# ── History back-fill ───────────────────────────────────────────────────
HISTORY_DAYS=30
BACKFILL_ON_STARTUP=true
SEED_ON_STARTUP=true

# ── Machine learning ────────────────────────────────────────────────────
ML_ENABLED=true
ML_MIN_TRAINING_SAMPLES=120
ML_REFIT_INTERVAL_SECONDS=300
ML_CONTAMINATION=0.03

# ── CORS ────────────────────────────────────────────────────────────────
# The Vite dev server and its preview port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
