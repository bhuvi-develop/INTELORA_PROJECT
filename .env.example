# ─── INTELORA runtime configuration ──────────────────────────────────────────
# Copy to `.env.local` and adjust per environment.

# Platform API gateway. When VITE_USE_MOCKS=true the in-browser telemetry
# simulator answers every request instead and this value is ignored.
VITE_API_BASE_URL=https://api.intelora.io/v1

# Serve the deterministic MIKOS telemetry simulator instead of a live gateway.
VITE_USE_MOCKS=true

# Simulated gateway latency envelope, milliseconds.
VITE_MOCK_LATENCY_MIN=120
VITE_MOCK_LATENCY_MAX=420

# ─── Grafana embedding ───────────────────────────────────────────────────────
# Base URL of the Grafana instance rendering telemetry panels.
VITE_GRAFANA_BASE_URL=https://grafana.intelora.io

# Default organisation id used when a panel does not declare one.
VITE_GRAFANA_ORG_ID=1

# Kiosk chrome: 1 = hide Grafana chrome entirely, tv = keep the time picker.
VITE_GRAFANA_KIOSK=1

# Grafana theme applied to embedded panels.
VITE_GRAFANA_THEME=dark

# Dashboard UIDs / slugs per module. Format: <uid>/<slug>
VITE_GRAFANA_DASHBOARD_TELEMETRY=mikos-telemetry/mikos-telemetry
VITE_GRAFANA_DASHBOARD_ANOMALY=mikos-anomaly/mikos-anomaly-detection
VITE_GRAFANA_DASHBOARD_PREDICTIVE=mikos-rul/mikos-predictive-maintenance
VITE_GRAFANA_DASHBOARD_APM=mikos-apm/mikos-asset-performance
VITE_GRAFANA_DASHBOARD_OEE=mikos-oee/mikos-overall-equipment-effectiveness

# ─── Session ─────────────────────────────────────────────────────────────────
# Idle window before the session is invalidated, minutes.
VITE_SESSION_IDLE_MINUTES=30

# Telemetry poll interval for live tiles, milliseconds.
VITE_LIVE_POLL_MS=15000
